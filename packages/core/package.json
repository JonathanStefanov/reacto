{
  "name": "@reacto/core",
  "version": "0.1.0",
  "description": "Core ORM — Django-style models, fields, migrations, and query builder for Reacto",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.0",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": ["dist"],
  "keywords": ["react", "django", "orm", "postgresql", "fullstack", "typescript"],
  "license": "MIT"
}
